{
    "swagger": "2.0",
    "info": {
        "description": "A complete runnable Swagger integration example",
        "title": "Iris Swagger API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api/v1",
    "paths": {
        "/greet": {
            "post": {
                "description": "Generates a greeting based on name and language",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "User"
                ],
                "summary": "Generate greeting",
                "parameters": [
                    {
                        "description": "Request parameters",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.GreetRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.GreetResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Checks the service status",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "System"
                ],
                "summary": "Service health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.HealthCheckResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "main.GreetRequest": {
            "type": "object",
            "required": [
                "name"
            ],
            "properties": {
                "language": {
                    "type": "string",
                    "enum": [
                        "en",
                        "es",
                        "fr"
                    ],
                    "example": "en"
                },
                "name": {
                    "type": "string",
                    "example": "John"
                }
            }
        },
        "main.GreetResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "Hello John!"
                },
                "status": {
                    "type": "integer",
                    "example": 200
                }
            }
        },
        "main.HealthCheckResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "example": "OK"
                },
                "version": {
                    "type": "string",
                    "example": "1.0.0"
                }
            }
        }
    }
}